# ansible-lint config for the validate workflow.
profile: production

exclude_paths:
  - ansible/group_vars/vars.yml
  - ansible/group_vars/vault.yml
  - ansible/collections/ansible_collections/

# Deliberate deviations, kept as an explicit list rather than silent debt.
skip_list:
  # backup.yml streams tar straight into rclone. The archive/unarchive
  # modules cannot do that and would stage a second full copy on disk.
  - command-instead-of-module
  # copy/template tasks writing root-owned files under /etc rely on the
  # default mode on purpose; spelling it out everywhere is churn, not safety.
  - risky-file-permissions
