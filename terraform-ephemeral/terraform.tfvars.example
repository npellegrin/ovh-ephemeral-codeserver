# ovh_project_id, compute_region, keypair_name are NOT here: `make`
# generates them into generated.tfvars from terraform-bootstrap's outputs
# on every run.

instance_flavor = "b3-8"
instance_image  = "Debian 13"
volume_size_gb  = 40

# By default OVH projects have a security_group quota of 0
# so this stack defaults to not creating a security group.
# Flip to true once your account's quota allows creating security groups.
create_security_group = false

# allowed_*_cidrs below only matter if you set create_security_group = true.
allowed_ssh_cidrs   = ["YOUR_PUBLIC_IP/32"]
allowed_https_cidrs = ["0.0.0.0/0"]
allowed_http_cidrs  = ["0.0.0.0/0"]

# DNS: true lets Terraform manage the A record in an OVH zone (needs the
# OVH_* env vars, see README). false means you point DNS yourself and
# `make create` pauses to let you do it before requesting the certificate.
manage_dns    = false
dns_zone      = "example.com"
dns_subdomain = "dev"
dns_ttl       = 60
