---
# Copy to group_vars/vars.yml and fill in the values. Non-secret only;
# secrets go in vault.yml. group_vars/vars.yml is gitignored.
# `make generate-vault-vars` rewrites s3_endpoint / s3_bucket from
# terraform-bootstrap outputs.

# --- OVH S3 Object Storage (non-secret) ---
s3_endpoint: "https://s3.<region>.io.cloud.ovh.net"
s3_bucket: "CHANGEME"

# --- code-server ---
code_server_user: "dev"
code_server_port: 8080

# --- nginx / Let's Encrypt ---
domain_name: "dev.example.com"
letsencrypt_email: "admin@example.com"

# --- nftables ingress filtering ---
allowed_ssh_cidrs:
  - "0.0.0.0/0"
allowed_http_cidrs:
  - "0.0.0.0/0"
allowed_https_cidrs:
  - "0.0.0.0/0"

# --- backup / restore ---
# Absolute paths tarred by backup.yml and, on restore, the only paths
# safe_restore.sh.j2 is allowed to write back to the filesystem.
backup_paths:
  - "/home/{{ code_server_user }}"
backup_excludes:
  - "*/.cache"
  - "*/node_modules"
