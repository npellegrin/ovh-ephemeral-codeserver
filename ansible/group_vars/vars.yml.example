---
# Copy to group_vars/vars.yml and fill in the values. Non-secret only;
# secrets go in vault.yml. group_vars/vars.yml is gitignored.
# `make generate-vault-vars` rewrites backup_bucket / swift_region /
# swift_tenant_id from terraform-bootstrap outputs.

# --- OVH Object Storage (Swift), non-secret ---
swift_auth: "https://auth.cloud.ovh.net/v3"
swift_region: "GRA"
swift_tenant_id: "CHANGEME"
backup_bucket: "CHANGEME"

# --- code-server ---
code_server_user: "dev"
code_server_port: 8080

# --- nginx / Let's Encrypt ---
domain_name: "dev.example.com"
letsencrypt_email: "admin@example.com"

# --- nftables ingress filtering ---
allowed_ssh_cidrs:
  - "0.0.0.0/0"
allowed_http_cidrs:
  - "0.0.0.0/0"
allowed_https_cidrs:
  - "0.0.0.0/0"
# IPv6 counterparts. Set to [] to keep a port IPv4-only.
allowed_ssh_cidrs_v6:
  - "::/0"
allowed_http_cidrs_v6:
  - "::/0"
allowed_https_cidrs_v6:
  - "::/0"

# --- customization (optional dev tooling) ---
# Each flag installs one tool via the customization role. All default to false
# (roles/customization/defaults/main.yml); the toolchains they install are in
# backup_excludes below, since every provision re-installs them from scratch.
customization_terraform_plugin_cache: false  # ~/.terraform.d/plugin-cache + ~/.terraformrc
customization_tfenv: false                   # Terraform version manager
customization_uv: false                      # uv + CPython 3.13 / 3.14
customization_nvm: false                     # Node version manager
customization_rustup: false                  # rustup + cargo
customization_docker: false                  # Docker Engine + Compose plugin
customization_claude_cli: false              # Claude Code CLI + ripgrep

# --- backup / restore ---
# Absolute paths tarred by backup.yml and, on restore, the only paths
# safe_restore.sh.j2 is allowed to write back to the filesystem.
backup_paths:
  - "/home/{{ code_server_user }}"
backup_excludes:
  - "*/.cache"
  - "*/node_modules"
  # rclone's Swift credentials, regenerated every run. Never back them up.
  - "*/.config/rclone"
  # Toolchains and caches installed by the customization role. Large, binary,
  # and re-created on every provision, so keep them out of the archive. Drop
  # the matching line if you want a tool's state to survive a destroy/create.
  - "*/.tfenv"                     # tfenv + the terraform builds it installs
  - "*/.nvm"                       # nvm + its node builds
  - "*/.rustup"                    # rust toolchains
  - "*/.cargo"                     # cargo binaries + crate registry
  - "*/.local/share/uv"            # uv-managed CPython builds and tools
  - "*/.local/share/claude"        # claude native-install versions, if any
  - "*/.docker"                    # docker cli / buildx state
  # Per-project artifacts these toolchains regenerate from a lockfile or
  # manifest. Not written by the role, but they only exist once it is enabled.
  - "*/.terraform.d/plugin-cache"  # shared provider cache, refilled by `terraform init`
  - "*/.terraform"                 # per-project provider dirs, same
  - "*/.npm"                       # npm download cache
  - "*/.venv"                      # python virtualenvs, rebuilt by `uv sync`
